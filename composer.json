{
    "name": "ehdev/oro-basics-bundle",
    "description": "Basic configuration, helper and tools for an oro application",
    "type": "symfony-bundle",
    "homepage": "https://github.com/RocKordier/OroBasicsBundle",
    "keywords": [
        "Oro Platform",
        "Symfony",
        "Basics"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "[RocKordier] Eric Hertwig",
            "homepage": "http://eric-hertwig.de"
        }
    ],
    "repositories": {
        "oro": {
            "type": "composer",
            "url": "https://packagist.orocrm.com"
        }
    },
    "autoload": {
        "psr-4": {
            "EHDev\\BasicsBundle\\": [
                "src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EHDev\\BasicsBundle\\": [
                "tests/"
            ]
        }
    },
    "require": {
        "php": "^8.5",
        "oro/platform": "^7.0",
        "gedmo/doctrine-extensions": "^3.10",
        "stof/doctrine-extensions-bundle": "^1.7",
        "spatie/emoji": "^4.1",
        "nikic/iter": "^2.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "jangregor/phpstan-prophecy": "^2.3",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
